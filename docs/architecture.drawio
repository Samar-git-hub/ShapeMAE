 M masked&lt;/b&gt;&lt;br&gt;checked again in&lt;br&gt;the encoder" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#2a2108;strokeColor=#fbbf24;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="190" height="110" as="geometry" /></mxCell><mxCell id="mk8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;" edge="1" parent="1" source="mk2" target="mk3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mk3" target="mk4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mk3" target="mk5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="mk4" target="mk6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="mk5" target="mk6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;" edge="1" parent="1" source="mk6" target="mk7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk14" value="The shape-matched control: same geometry, wrong image" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=none;strokeColor=#60a5fa;dashed=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="640" height="150" as="geometry" /></mxCell><mxCell id="mk15" value="&lt;b&gt;Image i+1 in the batch&lt;/b&gt;&lt;br&gt;its objects, its layout" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1c1c1e;strokeColor=#a1a1aa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="220" height="75" as="geometry" /></mxCell><mxCell id="mk16" value="&lt;b&gt;Skip-fit on that layout&lt;/b&gt;&lt;br&gt;same code as arm B" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#172033;strokeColor=#60a5fa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="285" y="340" width="180" height="75" as="geometry" /></mxCell><mxCell id="mk17" value="&lt;b&gt;Applied to image i&lt;/b&gt;&lt;br&gt;blobs that ignore&lt;br&gt;image i&#x27;s objects" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#172033;strokeColor=#60a5fa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="490" y="340" width="150" height="75" as="geometry" /></mxCell><mxCell id="mk18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;" edge="1" parent="1" source="mk15" target="mk16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;" edge="1" parent="1" source="mk16" target="mk17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="mk20" value="The adaptive controller (arm C): once per epoch, no extra network" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=none;strokeColor=#a78bfa;dashed=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="455" width="1340" height="165" as="geometry" /></mxCell><mxCell id="mk21" value="&lt;b&gt;Per-category loss&lt;/b&gt;&lt;br&gt;mean over hidden patches,&lt;br&gt;clipped at 99th percentile" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="240" height="85" as="geometry" /></mxCell><mxCell id="mk22" value="&lt;b&gt;Relative difficulty&lt;/b&gt;&lt;br&gt;category mean / overall mean&lt;br&gt;so loss decay cancels" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="510" width="240" height="85" as="geometry" /></mxCell><mxCell id="mk23" value="&lt;b&gt;EMA, momentum 0.9&lt;/b&gt;&lt;br&gt;about a 10-epoch memory" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="510" width="220" height="85" as="geometry" /></mxCell><mxCell id="mk24" value="&lt;b&gt;Weight&lt;/b&gt;&lt;br&gt;(EMA / mean)^&amp;tau;, clipped to [0.25, 4]&lt;br&gt;&amp;tau; ramps 0 to 4 after warmup" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fon