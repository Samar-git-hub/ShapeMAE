mxCell id="ev7" value="&lt;b&gt;k-NN&lt;/b&gt; (k = 20, cosine)&lt;br&gt;Do similar images sit close together?&lt;br&gt;raw and z-scored features" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="485" y="70" width="350" height="76" as="geometry" /></mxCell><mxCell id="ev8" value="&lt;b&gt;Linear&lt;/b&gt;&lt;br&gt;Is there a separating hyperplane?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="485" y="170" width="350" height="60" as="geometry" /></mxCell><mxCell id="ev9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev2" target="ev6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ev10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev6" target="ev7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ev11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ev6" target="ev8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ev12" value="Per patch: nothing pooled away" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColo