<mxfile host="app.diagrams.net"><diagram name="Overview" id="ov"><mxGraphModel dx="1400" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0" background="#121212"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ov1" value="1. Curate (annotations only)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=none;strokeColor=#a1a1aa;dashed=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="290" height="400" as="geometry" /></mxCell><mxCell id="ov2" value="&lt;b&gt;COCO train2017&lt;/b&gt;&lt;br&gt;118,287 images scanned&lt;br&gt;from the JSON, no pixels" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1c1c1e;strokeColor=#a1a1aa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="80" as="geometry" /></mxCell><mxCell id="ov3" value="&lt;b&gt;Solve the mask budget&lt;/b&gt;&lt;br&gt;coverage &amp;ge; r + 0.10&lt;br&gt;largest object &amp;le; r&lt;br&gt;r = 0.40, so M = 78 of 196" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1c1c1e;strokeColor=#a1a1aa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="250" height="105" as="geometry" /></mxCell><mxCell id="ov4" value="&lt;b&gt;15,000 cluttered images&lt;/b&gt;&lt;br&gt;13,500 train, 1,500 validation&lt;br&gt;uint8 memmaps, 3.7 GB" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1c1c1e;strokeColor=#a1a1aa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="305" width="250" height="90" as="geometry" /></mxCell><mxCell id="ov5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;" edge="1" parent="1" source="ov2" target="ov3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;" edge="1" parent="1" source="ov3" target="ov4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov7" value="2. Four masks, one budget" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=none;strokeColor=#60a5fa;dashed=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="310" height="400" as="geometry" /></mxCell><mxCell id="ov8" value="&lt;b&gt;A: random&lt;/b&gt;&lt;br&gt;78 scattered patches" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#172033;strokeColor=#60a5fa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="70" width="270" height="62" as="geometry" /></mxCell><mxCell id="ov9" value="&lt;b&gt;A2: donor blobs&lt;/b&gt;&lt;br&gt;whole objects, from another image" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#172033;strokeColor=#60a5fa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="152" width="270" height="62" as="geometry" /></mxCell><mxCell id="ov10" value="&lt;b&gt;B: own objects&lt;/b&gt;&lt;br&gt;whole objects, from this image" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#172033;strokeColor=#60a5fa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="234" width="270" height="62" as="geometry" /></mxCell><mxCell id="ov11" value="&lt;b&gt;C: adaptive&lt;/b&gt;&lt;br&gt;as B, hard categories more often" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#172033;strokeColor=#60a5fa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="316" width="270" height="62" as="geometry" /></mxCell><mxCell id="ov12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.895;entryDx=0;entryDy=0;" edge="1" parent="1" source="ov4" target="ov7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov13" value="3. Masked autoencoder (400 epochs, 5 seeds per arm)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=none;strokeColor=#a78bfa;dashed=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="660" height="400" as="geometry" /></mxCell><mxCell id="ov14" value="&lt;b&gt;ViT-Tiny encoder&lt;/b&gt;&lt;br&gt;5.5M parameters&lt;br&gt;reads the 118 visible patches" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="720" y="110" width="230" height="100" as="geometry" /></mxCell><mxCell id="ov15" value="&lt;b&gt;Decoder&lt;/b&gt;&lt;br&gt;visible tokens + mask tokens&lt;br&gt;at the hidden positions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="985" y="110" width="180" height="100" as="geometry" /></mxCell><mxCell id="ov16" value="&lt;b&gt;Loss&lt;/b&gt;&lt;br&gt;MSE on the 78&lt;br&gt;hidden patches" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="140" height="100" as="geometry" /></mxCell><mxCell id="ov17" value="&lt;b&gt;Category controller (arm C only)&lt;/b&gt;&lt;br&gt;per-category loss, EMA, sampling weight for the next epoch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" 