=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ov17" target="ov11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov24" value="feedback" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#d4d4d8;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="690" y="352" width="110" height="22" as="geometry" /></mxCell><mxCell id="ov25" value="4. Read the encoder (trained on the 13,500 images, chosen on validation)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=14;arcSize=3;fillColor=none;strokeColor=#34d399;dashed=1;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="450" width="1040" height="170" as="geometry" /></mxCell><mxCell id="ov26" value="&lt;b&gt;k-NN&lt;/b&gt;&lt;br&gt;no parameters" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="170" height="90" as="geometry" /></mxCell><mxCell id="ov27" value="&lt;b&gt;Linear&lt;/b&gt;&lt;br&gt;mean-pooled" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="220" y="505" width="170" height="90" as="geometry" /></mxCell><mxCell id="ov28" value="&lt;b&gt;Class attention&lt;/b&gt;&lt;br&gt;each class learns&lt;br&gt;where to look" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="400" y="505" width="200" height="90" as="geometry" /></mxCell><mxCell id="ov29" value="&lt;b&gt;Dense&lt;/b&gt;&lt;br&gt;category per patch" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="610" y="505" width="200" height="90" as="geometry" /></mxCell><mxCell id="ov30" value="&lt;b&gt;Fine-tune&lt;/b&gt;&lt;br&gt;whole encoder" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="505" width="220" height="90" as="geometry" /></mxCell><mxCell id="ov31" value="frozen encoder" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#d4d4d8;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="478" width="770" height="22" as="geometry" /></mxCell><mxCell id="ov32" value="weights move" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#d4d4d8;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="820" y="478" width="220" height="22" as="geometry" /></mxCell><mxCell id="ov33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.784;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ov14" target="ov25"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov34" value="pretrained encoder" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#d4d4d8;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="842" y="424" width="150" height="22" as="geometry" /></mxCell><mxCell id="ov35" value="&lt;b&gt;Held-out test&lt;/b&gt;&lt;br&gt;COCO val2017, 4,952 images,&lt;br&gt;read once.&lt;br&gt;Paired contrasts, bootstrap&lt;br&gt;over seeds and images." style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#2a2108;strokeColor=#fbbf24;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1100" y="470" width="260" height="130" as="geometry" /></mxCell><mxCell id="ov36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#ffffff;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#ffffff;fontSize=12;labelBackgroundColor=#121212;" edge="1" parent="1" source="ov30" target="ov35"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ov37" value="data" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1c1c1e;strokeColor=#a1a1aa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="200" height="34" as="geometry" /></mxCell><mxCell id="ov38" value="masking policy" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#172033;strokeColor=#60a5fa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="235" y="650" width="200" height="34" as="geometry" /></mxCell><mxCell id="ov39" value="trained on images, no labels" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#231a33;strokeColor=#a78bfa;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="450" y="650" width="200" height="34" as="geometry" /></mxCell><mxCell id="ov40" value="reads the encoder, uses labels" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#10261f;strokeColor=#34d399;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="665" y="650" width="200" height="34" as="geometry" /></mxCell><mxCell id="ov41" value="output" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#2a2108;strokeColor=#fbbf24;fontColor=#ffffff;arcSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="650" width="200" height="34" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Masking in detail" id="mk"><mxGraphModel dx="1400" dy="640" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="640" math="0" shadow="0" background="#121212"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="mk1" value="Skip-fit: build one object mask with exactly M patches" style="rounded=1;w